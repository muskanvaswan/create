# Copy to .env.local and fill in. Nothing here is read at build time —
# the contact endpoint reads it per request, so values can change without
# a rebuild.

# --- SMTP (outbound mail for contact form enquiries) -----------------------
# With these unset the site still runs: enquiries are validated, accepted and
# written to ENQUIRY_LOG_PATH, and a warning is logged. Nothing is emailed.
SMTP_HOST=
SMTP_PORT=587
# Leave unset to infer from the port (implicit TLS on 465, STARTTLS otherwise).
SMTP_SECURE=
SMTP_USER=
SMTP_PASSWORD=

# --- Envelope --------------------------------------------------------------
# Must be an address the SMTP account is authorised to send as, or SPF/DKIM
# will fail. The visitor's own address is set as Reply-To.
CONTACT_FROM="CATEYE Website <no-reply@cateyetech.com>"
# Where enquiries land. Defaults to info@cateyetech.com.
CONTACT_TO=info@cateyetech.com

# --- Durable record --------------------------------------------------------
# Every accepted enquiry is appended here as JSON Lines, so nothing is lost if
# mail delivery fails. Point this at a persistent volume in production.
ENQUIRY_LOG_PATH=.data/enquiries.jsonl
